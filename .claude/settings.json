{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "agent": "fabrica-orquestrador",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git merge*)",
      "Bash(git rev-parse*)",
      "Bash(git grep*)",
      "Bash(gh auth status*)",
      "Bash(gh pr create*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr view*)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(python *)",
      "Bash(pytest*)",
      "Bash(specify *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(powershell * .specify/scripts/powershell/*)",
      "Bash(pwsh * .specify/scripts/powershell/*)",
      "Bash(.specify/scripts/powershell/*)",
      "Bash(./.specify/scripts/powershell/*)"
    ],
    "ask": [
      "Agent(fabrica-arquiteto)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge*)",
      "Bash(*gh.exe* pr merge*)",
      "Edit(.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "fabrica-.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/slack-notify.js\""
          }
        ]
      }
    ]
  }
}
